{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* electron/main.mjs and scripts/: plain JavaScript, checked with // @ts-check */
    "allowJs": true
  },
  "include": [
    "vite.config.ts",
    "vitest.oracle.config.ts",
    "playwright.config.ts",
    "playwright.server.config.ts",
    "playwright.desktop.config.ts",
    "electron/main.mjs",
    "scripts/prepare-desktop.mjs"
  ]
}
